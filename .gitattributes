# Line-ending normalization.
#
# Files are stored with LF in the repository and checked out with native line
# endings, except for the Visual Studio files which always use CRLF.

* text=auto

# Source and documentation: always LF.
*.c                    text eol=lf
*.cpp                  text eol=lf
*.h                    text eol=lf
*.md                   text eol=lf
*.txt                  text eol=lf
*.cmake                text eol=lf
CMakeLists.txt         text eol=lf
*.yml                  text eol=lf
.gitattributes         text eol=lf
.gitignore             text eol=lf
.editorconfig          text eol=lf

# Visual Studio solution and project files: CRLF.
*.sln                  text eol=crlf
*.vcxproj              text eol=crlf
*.vcxproj.filters      text eol=crlf

# Binary files.
*.png                  binary
*.jpg                  binary
*.jpeg                 binary
*.gif                  binary
*.ico                  binary
